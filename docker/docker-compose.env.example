# Template for docker/docker-compose.env (copy to docker-compose.env, which is
# gitignored — never commit real values).
#
#   cp docker-compose.env.example docker-compose.env

POSTGRES_USER=telco_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=telcoqualify

# Keep in sync with the postgres service above.
DATABASE_URL=postgresql://telco_admin:change-me-strong-password@postgres:5432/telcoqualify?schema=public
DATABASE_TYPE=postgres

# MUST be at least 32 characters. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
