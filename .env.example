# TelcoQualify Enterprise Environment Configuration

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=super-secret-dev-jwt-key-change-in-production-min-32-chars-long!
JWT_EXPIRES_IN=8h

# Database Configuration (PostgreSQL in production/docker; SQLite/JSON storage for zero-dep dev fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telcoqualify?schema=public
DATABASE_TYPE=sqlite
DATABASE_FILE=./storage/telcoqualify_dev.db

# Storage / Private Document Uploads
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_FILE_SIZE_MB=25

# Observability & Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true

# Feature Flags
FF_AUTOMATED_EXTRACTION=true
FF_ADVANCED_QUALIFICATION=true
FF_EXPERT_WORKFLOW=true
