# TelcoQualify Enterprise Environment Configuration
#
# ONLY the variables below are actually read by the application.
# (Previous revisions of this file listed PORT, APP_URL, DATABASE_URL,
# DATABASE_TYPE, STORAGE_*, LOG_LEVEL and feature flags — none of those
# are consumed anywhere in the code; the datastore is an in-memory
# repository and upload/audit/log configuration is not env-driven.)

# Authentication — the ONLY secret. Session JWTs are signed with it.
# Development falls back to a built-in dev-only key; production STARTUP
# FAILS if it is missing or shorter than 32 characters.
JWT_SECRET=super-secret-dev-jwt-key-change-in-production-min-32-chars-long!

# Seeding guard. Demo fixtures (clearly fictional @example.test personas,
# demo customers/cases) are seeded automatically outside production.
# In production the app starts EMPTY unless you explicitly opt in:
#   TELCO_ALLOW_SEEDING=true
# Never set this in a real deployment.
# TELCO_ALLOW_SEEDING=true

# Standard Next.js knob (read by Next itself): development | production | test
NODE_ENV=development
